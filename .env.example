# Neon Postgres, pooled connection string.
# Use a database separate from the mock-test platform — these are two products
# with two schemas and no shared tables.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# 32+ random bytes. Signs the session JWT. Rotating this signs everyone out.
#   openssl rand -base64 48
SESSION_SECRET=""

# 32+ random bytes. Keys the HMAC lookup index for access codes.
# Rotating this invalidates every stored code_index — every buyer would need a
# reissued code. Set it once and leave it alone.
#   openssl rand -base64 48
LOGIN_CODE_PEPPER=""

# --- Razorpay -------------------------------------------------------------
# Dashboard → Settings → API Keys. Use rzp_test_* keys until you are ready.
#
# CAD checkout needs International Payments enabled on the account
# (Dashboard → Settings → Configuration). INR uses the domestic payment path.
# Razorpay never silently changes one selected currency into the other.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Dashboard → Settings → Webhooks. Create a webhook pointed at
#   https://<your-domain>/api/webhooks/razorpay
# subscribed to the `payment.captured` event, and paste its secret here.
# Without this, payments succeed and nobody is ever given access.
RAZORPAY_WEBHOOK_SECRET=""

# --- Email (optional at first) --------------------------------------------
# resend.com → API Keys. If unset, purchases still work and the access code is
# shown on the success screen — it just is not emailed.
RESEND_API_KEY=""
# Must be a domain verified in Resend.
EMAIL_FROM="Français on Tips <bonjour@francaisontips.com>"

# No owner-alert address: a buyer who orders a mock test or a lesson plan is
# sent a WhatsApp link and opens the conversation themselves, so nothing depends
# on us noticing an order first. The number lives in `lib/contact.ts`.

# Absolute base for links inside emails. On Vercel this falls back to the
# deployment URL, so it is only needed to pin a custom domain.
NEXT_PUBLIC_SITE_URL="https://study.francaisontips.com"

# --- Demo class booking (/demo and /admin) ---------------------------------
# The header's "Book a Free Demo Class" button stays on Calendly until this is
# "on". Read at build time — change it, then redeploy.
NEXT_PUBLIC_DEMO_BOOKING=""

# Owner login at /admin. Generate the hash with `pnpm admin:password`
# (base64 of an argon2id hash). The secret is separate from SESSION_SECRET on
# purpose: rotating it signs the owner out and touches no buyer.
#   openssl rand -base64 48
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=""

# Where booking notices go, and the zone they are written in.
ADMIN_EMAIL=""
ADMIN_TIME_ZONE="Asia/Kolkata"

# Google Meet links. Optional — without them, paste a Meet link per slot.
# Google Cloud → OAuth client of type "Desktop app"; then `pnpm google:auth`
# prints the refresh token. The OAuth app must be published ("In production"),
# or the token expires after 7 days.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_CALENDAR_ID="primary"

# Cloudflare Turnstile on the booking form. Optional; both or neither.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
